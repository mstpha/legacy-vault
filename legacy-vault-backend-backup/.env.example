# =====================================================================================
# BACKUP backend (HA failover). See docs/HA_SETUP.md.
# Copy to .env (git-ignored). Everything not under "Supabase B" / "DB router" / "Sync" must be
# IDENTICAL to the primary's .env - above all the JWT secrets, or A-issued tokens are rejected.
# =====================================================================================

# --- Server ---
SERVER_ROLE=backup
PORT=4001
NODE_ENV=development
CORS_ORIGINS="*"               # same list as the primary

# --- Supabase A (same values as the primary) ---
DATABASE_URL="postgresql://postgres.<a-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres:<password>@db.<a-ref>.supabase.co:5432/postgres"
SUPABASE_URL="https://<a-ref>.supabase.co"
SUPABASE_ANON_KEY="<a-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<a-service-role-key>"      # server-side only, NEVER expose to the app

# --- Supabase B (warm standby project) ---
B_DATABASE_URL="postgresql://postgres.<b-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
B_DIRECT_URL="postgresql://postgres:<password>@db.<b-ref>.supabase.co:5432/postgres"   # migrations / db push only
B_SUPABASE_URL="https://<b-ref>.supabase.co"
B_SUPABASE_ANON_KEY="<b-anon-key>"                    # not used by the code (no RLS-scoped clients), kept for completeness
B_SUPABASE_SERVICE_ROLE_KEY="<b-service-role-key>"

SUPABASE_STORAGE_BUCKET="capsule-files"               # same bucket name in both projects

# --- DB router (A_ACTIVE / B_ACTIVE / DRAINING) ---
A_FAIL_THRESHOLD=3              # consecutive failed A checks before A_ACTIVE -> B_ACTIVE
A_RECOVER_THRESHOLD=5           # consecutive good A checks before B_ACTIVE -> DRAINING (and required to finish it)
A_CHECK_INTERVAL_MS=2000
A_CHECK_TIMEOUT_MS=1500
B_FAIL_THRESHOLD=3
FINAL_DRAIN_THRESHOLD=50        # outbox size under which the write-paused final drain starts
FINAL_DRAIN_TIMEOUT_MS=15000    # max write pause; on timeout writes resume and DRAINING retries
WRITE_PAUSE_RETRY_AFTER_S=2
DRAIN_BATCH_SIZE=200
SYNC_CHECK_ON_CUTOVER=true      # run sync-check (auto-fix) on DRAINING -> A_ACTIVE

# --- Sync worker (npm run sync:worker) ---
SYNC_WORKER_INTERVAL_MS=1000
SYNC_BATCH_SIZE=200
SYNC_MAX_BACKOFF_MS=30000
SYNC_MAX_ATTEMPTS=10            # data errors (unique/FK) before a change is marked 'conflict'
SYNC_WORKER_STATUS_PORT=4100
SYNC_WORKER_STATUS_URL="http://127.0.0.1:4100/status"   # read by the backup's GET /health
SYNC_CHECK_INTERVAL_MS=3600000  # scheduled sync-check in the worker; 0 disables
SYNC_CHECK_GRACE_MS=60000       # rows written more recently than this are treated as in flight
SYNC_CHECK_STORAGE=true
SYNC_CHANGELOG_RETENTION_DAYS=3
SYNC_TOMBSTONE_RETENTION_DAYS=30

# --- Idempotency (same as the primary) ---
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_MS=60000

# --- Auth / JWT (MUST equal the primary's) ---
JWT_ACCESS_SECRET="change-me-access-32-bytes-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-32-bytes-min"
JWT_REFRESH_EXPIRES_IN="30d"

# --- MFA (TOTP) ---
MFA_ISSUER="Digital Legacy Vault"

# --- Redis (shared with the primary: BullMQ runs each inactivity sweep on one live worker) ---
REDIS_URL="redis://localhost:6379"
INACTIVITY_SWEEP_INTERVAL_MS=900000
INACTIVITY_WORKER_ENABLED=true

# --- SMTP (same as the primary) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Digital Legacy Vault"

# --- Sentry ---
SENTRY_DSN=""

# --- Logging ---
LOG_LEVEL="info"
