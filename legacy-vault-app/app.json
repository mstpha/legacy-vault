{
  "expo": {
    "name": "Digital Legacy Vault",
    "slug": "legacy-vault-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legacyvault.app"
    },
    "android": {
      "package": "com.legacyvault.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing"
    ]
  }
}
