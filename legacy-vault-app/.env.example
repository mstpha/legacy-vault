# Copy to .env (git-ignored). Expo exposes EXPO_PUBLIC_* variables to the app at build time.
# Physical phone on the same Wi-Fi: your computer's LAN IP. Production: the deployed HTTPS URLs.
EXPO_PUBLIC_PRIMARY_API_URL=http://192.168.1.23:4000/api
EXPO_PUBLIC_BACKUP_API_URL=http://192.168.1.23:4001/api
# (EXPO_PUBLIC_API_URL, the pre-HA name, is still read as the primary URL when the line above is absent.)

# HA failover tuning (defaults shown)
EXPO_PUBLIC_HEALTH_PROBE_INTERVAL_MS=5000
EXPO_PUBLIC_HEALTH_TTL_MS=10000
EXPO_PUBLIC_PREFLIGHT_TIMEOUT_MS=1000
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
EXPO_PUBLIC_FAILBACK_HEALTHY_PROBES=3
