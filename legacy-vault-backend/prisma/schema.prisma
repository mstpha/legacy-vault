// Digital Legacy Vault — Prisma schema
// Sprint 1 deliverable: complete data model for the whole app (per backlog),
// even though only User / RefreshToken are exercised by auth logic this sprint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum CapsuleType {
  DOCUMENT
  CREDENTIAL
  MESSAGE
  IMAGE
}

// Mirrors RM10 exactly: 7 states, one `state` column, no parallel booleans.
enum CapsuleState {
  DRAFT
  ACTIVE
  INACTIVITY_ALERT
  PENDING_VALIDATION
  UNLOCKED
  REVOKED
  ARCHIVED
}

// TESTATOR / GUARANTOR / BENEFICIARY are capsule-scoped: a user holds them per
// capsule (via Capsule.testatorId, CapsuleGuarantor, CapsuleBeneficiary), not as
// a fixed account type — anyone can create a capsule and becomes its testator by
// doing so. They exist in this enum only to key the permissions matrix.
//
// ADMIN is different: it's a real, global flag stored on User.role below. It's
// the only role that can view/edit the Roles & Permissions page itself.
enum Role {
  TESTATOR
  GUARANTOR
  BENEFICIARY
  ADMIN
}

enum NotificationType {
  GUARANTOR_ASSIGNED
  INACTIVITY_ALERT
  VALIDATION_REQUEST
  CAPSULE_UNLOCKED
  CAPSULE_ACCESS_ATTEMPT
}

// ---------- Core identity ----------

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String

  // TOTP MFA (Sprint 1)
  mfaSecret  String? // encrypted at rest in a later hardening pass; null until enrolled
  mfaEnabled Boolean @default(false)

  // Global account flag. Everyone starts TESTATOR (meaning "ordinary user" — they
  // can still also act as a guarantor/beneficiary on other people's capsules
  // regardless of this field). Only ADMIN unlocks the Roles & Permissions page.
  role Role @default(TESTATOR)

  // Used by the inactivity engine in Sprint 3, tracked from Sprint 1 on every authenticated request
  lastLoginAt DateTime?
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publicKey          String?
  publicKeyUpdatedAt DateTime? @db.Timestamp(3)


  emailVerified             Boolean   @default(false)
  emailVerificationCodeHash String?
  emailVerificationExpiresAt DateTime?
  emailVerificationAttempts Int       @default(0)

  refreshTokens      RefreshToken[]
  capsulesAsTestator Capsule[]            @relation("TestatorCapsules")
  capsuleKeyShares   CapsuleKeyShare[]
  guarantorOf        CapsuleGuarantor[]
  beneficiaryOf      CapsuleBeneficiary[]
  validations        Validation[]
  notifications      Notification[]

  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Never store the raw token — only a hash of it (see src/utils/password.js hashToken)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String? // rotation chain, for reuse/theft detection

  createdByIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model CapsuleKeyShare {
  id         String @id @default(uuid())
  capsuleId  String
  userId     String
  wrappedKey String

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)

  capsule Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([capsuleId, userId])
  @@map("capsule_key_shares")
}

// ---------- Capsule domain (modeled now, built out from Sprint 2 onward) ----------

model Capsule {
  id         String @id @default(uuid())
  testatorId String
  testator   User   @relation("TestatorCapsules", fields: [testatorId], references: [id])

  title String
  type  CapsuleType
  state CapsuleState @default(DRAFT)

  // Client-side encrypted blob only — server/DB never sees plaintext (RM2, RM9).
  encryptedContent Bytes?

  // RM4 / RM10 parameters
  inactivityThresholdDays Int @default(90)
  graceWindowDays         Int @default(14)
  validationThreshold     Int @default(2)
  validationsReceived     Int @default(0)

  lastActivityCheckAt  DateTime?
  alertSentAt          DateTime?
  graceWindowExpiresAt DateTime?
  unlockedAt           DateTime?
  archivedAt           DateTime?
  revokedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guarantors    CapsuleGuarantor[]
  beneficiaries CapsuleBeneficiary[]
  keyShares     CapsuleKeyShare[]
  validations   Validation[]
  files         CapsuleFile[]

  @@index([testatorId])
  @@index([state])
  @@map("capsules")
}

// One row per attached file. The bytes themselves live in Supabase Storage
// (already encrypted client-side) — this table only tracks the pointer + metadata.
model CapsuleFile {
  id        String  @id @default(uuid())
  capsuleId String
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  storagePath String // path within the Supabase Storage bucket
  fileName    String
  mimeType    String // the ORIGINAL file's mime type; the stored bytes are opaque ciphertext
  sizeBytes   Int

  createdAt DateTime @default(now())

  @@index([capsuleId])
  @@map("capsule_files")
}

model CapsuleGuarantor {
  id        String  @id @default(uuid())
  capsuleId String
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  invitedAt DateTime @default(now())

  @@unique([capsuleId, userId]) // a user is a guarantor at most once per capsule
  @@map("capsule_guarantors")
}

model CapsuleBeneficiary {
  id        String  @id @default(uuid())
  capsuleId String
  capsule   Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  invitedAt       DateTime  @default(now())
  firstAccessedAt DateTime? // triggers UNLOCKED -> ARCHIVED (RM10) on first successful read

  @@unique([capsuleId, userId])
  @@map("capsule_beneficiaries")
}

model Validation {
  id          String  @id @default(uuid())
  capsuleId   String
  capsule     Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  guarantorId String
  guarantor   User    @relation(fields: [guarantorId], references: [id])

  validatedAt DateTime @default(now())

  // RM6: a guarantor can only validate once per capsule — enforced at the DB level.
  @@unique([capsuleId, guarantorId])
  @@map("validations")
}

// ---------- Cross-cutting: audit + notifications ----------

model AuditLog {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  userId    String?
  capsuleId String?
  action    String
  metadata  Json?
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())

  @@index([capsuleId])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  payload Json?
  sentAt  DateTime?
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// Drives the Roles & Permissions management page. One row per (role, permission)
// pair; `enabled` is what the page's toggle switches read/write. Server-side code
// calls permissions.service#assertPermission(role, key) before sensitive actions,
// so turning a switch off here actually blocks that action, not just hides a button.
model RolePermission {
  id         String   @id @default(uuid())
  role       Role
  permission String // e.g. "capsule.create", "capsule.activate", "validation.submit"
  label      String // human-readable text shown on the management page
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@map("role_permissions")
}
