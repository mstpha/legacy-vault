{
  "name": "legacy-vault-backend",
  "version": "0.1.0",
  "description": "Digital Legacy Vault - Backend API (Sprints 1-6)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "sweep:once": "node time-db.js",
    "load:sweep": "node tests/load/sweep-load.js",
    "load:http": "node tests/load/http-load.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@sentry/node": "^7.120.3",
    "@supabase/supabase-js": "^2.45.4",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "e2e",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/e2e/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup/env.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup/mocks.js"
        ]
      }
    ]
  }
}
