# Copy to .env.test. Used ONLY by the e2e tests and the load scripts.
# It MUST point at a disposable database (a second Supabase project, or a local Postgres):
# the tests create and delete users/capsules, and the load test inserts thousands of rows.
# The setup refuses to run unless the URL contains "test" (e.g. .../legacy_vault_test).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legacy_vault_test"
# Optional: direct (non-pooled) URL if TEST_DATABASE_URL goes through pgbouncer
# TEST_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/legacy_vault_test"
