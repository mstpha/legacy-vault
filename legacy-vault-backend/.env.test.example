# Copy to .env.test. Used ONLY by database-backed tests and load scripts.
# Use a SEPARATE, disposable Supabase project or local database. Never use your
# development, production, or HA standby project: load tests write and delete data.
# For Supabase, append application_name=legacy_vault_test to both connection URLs.
# Replace the project reference and URL-encoded database password with your test project's values.
TEST_DATABASE_URL="postgresql://postgres.TEST_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&application_name=legacy_vault_test"
# Direct (non-pooled) URL for Prisma migrations against that SAME test project.
TEST_DIRECT_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.TEST_PROJECT_REF.supabase.co:5432/postgres?application_name=legacy_vault_test"
